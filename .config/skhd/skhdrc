# ================================Window Settings================================
# Set window focus
# cmd + ctrl - h : yabai -m window --focus west
# cmd + ctrl - j : yabai -m window --focus south
# cmd + ctrl - k : yabai -m window --focus north
# cmd + ctrl - l : yabai -m window --focus east 

# Swap window position
# alt + shift - h : yabai -m window --swap west
# alt + shift - j : yabai -m window --swap south
# alt + shift - k : yabai -m window --swap north
# alt + shift - l : yabai -m window --swap east

# Move window position
# ctrl + shift - h : yabai -m window --warp west
# ctrl + shift - j : yabai -m window --warp south
# ctrl + shift - k : yabai -m window --warp north
# ctrl + shift - l : yabai -m window --warp east

# Adjust floating windows
# cmd + shift - backspace : yabai -m window --grid 5:5:1:1:3:3
# cmd + shift - return : yabai -m window --grid 1:1:0:0:1:1
# cmd + shift - h : yabai -m window --grid 1:2:0:0:1:1
# cmd + shift - j : yabai -m window --grid 2:1:0:1:1:1
# cmd + shift - k : yabai -m window --grid 2:1:0:0:1:1
# cmd + shift - l : yabai -m window --grid 1:2:1:0:1:1

# Focus window up/down in stack
cmd + shift - j : yabai -m window --focus "$(yabai -m query --windows --space | jq -re "[sort_by(.id, .frame) | .[] | select(.role == \"AXWindow\" and .subrole == \"AXStandardWindow\") | .id] | nth(index($(yabai -m query --windows --window | jq -re ".id")) - 1)")"
cmd + shift - k : yabai -m window --focus "$(yabai -m query --windows --space | jq -re "[sort_by(.id, .frame) | reverse | .[] | select(.role == \"AXWindow\" and .subrole == \"AXStandardWindow\") | .id] | nth(index($(yabai -m query --windows --window | jq -re ".id")) - 1)")"

# toggle menu bar opacity
fn - n: yabai -m config menubar_opacity 0.0
fn - m: yabai -m config menubar_opacity 1.0

# toggle window split type
alt - e : yabai -m window --toggle split

# toggle tiled/floating space /
cmd + shift - 0x2C : yabai -m space --layout $(yabai -m query --spaces --space | jq -r 'if .type == "bsp" then "float" elif .type == "float" then "stack" else "bsp" end')

# float / unfloat window ,
cmd + shift - 0x2B : yabai -m window --toggle float;\
          yabai -m window --grid 4:4:1:1:2:2

