#!/usr/bin/env python3
"""Block commits that would publish private info in this public repo.

Checks lines added in the staged changes (the private submodule is skipped)
against:
  - built-in patterns for secrets (keys, tokens) and private-network IPs
  - private/public-blocklist.txt: one case-insensitive regex per line
  - private/public-allowlist.txt: a flagged line that also matches one of these
    regexes is let through (deliberate exceptions)
The term lists live in the private repo so the terms themselves stay private.

Enabled by install.zsh with: git config core.hooksPath scripts/git-hooks
"""

import re
import subprocess
import sys
from pathlib import Path

BUILTIN = [
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"\bgh[pousr]_[A-Za-z0-9]{30,}",
    r"\bgithub_pat_[A-Za-z0-9_]{30,}",
    r"\bsk-ant-[A-Za-z0-9_-]{20,}",
    r"\bsk-[A-Za-z0-9]{32,}",
    r"\bAKIA[0-9A-Z]{16}\b",
    r"\bxox[abposr]-[A-Za-z0-9-]{10,}",
    r"\b192\.168\.\d{1,3}\.\d{1,3}\b",
    r"\b100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}\b",
]


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def load(path):
    if not path.is_file():
        return None
    lines = (l.strip() for l in path.read_text().splitlines())
    return [l for l in lines if l and not l.startswith("#")]


def main():
    root = Path(git("rev-parse", "--show-toplevel").strip())
    blocklist = load(root / "private" / "public-blocklist.txt")
    allowlist = load(root / "private" / "public-allowlist.txt") or []

    if blocklist is None:
        print("pre-commit: private/public-blocklist.txt not found (is the private submodule checked out?)")
        print("Refusing to commit to the public repo without it.")
        return 1

    blocked = [re.compile(p, re.I) for p in BUILTIN + blocklist]
    allowed = [re.compile(p, re.I) for p in allowlist]

    diff = git("diff", "--cached", "-U0", "--no-color", "--no-ext-diff", "--", ".", ":!private")
    hits = []
    path = None
    lineno = 0
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("@@"):
            m = re.search(r"\+(\d+)", line)
            lineno = int(m.group(1)) if m else 0
        elif line.startswith("+") and path:
            text = line[1:]
            for rx in blocked:
                m = rx.search(text)
                if m and not any(a.search(text) for a in allowed):
                    hits.append((path, lineno, m.group(0), text.strip()))
                    break
            lineno += 1

    if not hits:
        return 0

    print("pre-commit: BLOCKED - this would publish private info in the public dotfiles repo:\n")
    for path, n, match, text in hits:
        print(f"  {path}:{n}  [{match}]")
        print(f"      {text[:150]}")
    print("\nMove it to the private submodule (~/.dotfiles/private), or if it's a")
    print("deliberate exception add a regex to private/public-allowlist.txt.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
