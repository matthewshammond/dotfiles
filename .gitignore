\.config/asciinema/
\.config/gh/
\.gitconfig
\.gnupg/
\.ntfy.yml
\.ssh/
# Ignore all variations of .DS_Store in all directories
**/.[Dd][Ss]_[Ss]tore

# Python bytecode and editor backups
__pycache__/
*.pyc
*.bak

# Neovim plugin lockfile (changes on every :Lazy update)
.config/nvim/lazy-lock.json

# Karabiner rewrites these itself
.config/karabiner/automatic_backups/

# Claude Code user settings live in the private submodule (autoMode holds
# private infrastructure details); see private/.claude/settings.json
.claude/settings.json
